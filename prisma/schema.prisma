generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model SiteContent {
  id             Int      @id @default(1)
  heroEyebrow    String
  heroTitle      String
  heroText       String
  heroImage      String
  storyTitle     String
  storyText      String
  productsTitle  String
  ctaTitle       String
  whatsappNumber String
  updatedAt      DateTime @updatedAt
}

model Product {
  id           String   @id @default(cuid())
  name         String
  category     String
  description  String
  price        String
  format       String
  image        String
  ingredients  String
  conservation String
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([position])
}
