# Vercel Postgres (Storage > Postgres dans le dashboard Vercel, ou `vercel env pull .env.local`)
POSTGRES_URL="postgres://user:password@host/db?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://user:password@host/db?sslmode=require"

# Vercel Blob (Storage > Blob dans le dashboard Vercel)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Compte admin unique. Générer avec : pnpm exec tsx scripts/hash-password.ts "votre-mot-de-passe"
# (le script encode déjà le résultat en base64 — ne jamais coller un hash bcrypt
# brut ici, ses "$" sont interprétés comme des variables et vidés au chargement)
ADMIN_EMAIL="admin@biostore.cm"
ADMIN_PASSWORD_HASH_BASE64="JDJhJDEwJC4uLg=="

# Secret pour signer le cookie de session (chaîne aléatoire longue)
SESSION_SECRET="change-me-to-a-long-random-string"
